# ─────────────────────────────────────────────────────────────
#  Voice Agent — Environment Variables
#  Copy to .env and fill in your values before running.
# ─────────────────────────────────────────────────────────────

# Required: Get your API key at https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Server bind address and port
HOST=0.0.0.0
PORT=8000

# Comma-separated allowed CORS origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Override the Deepgram model (default: nova-2)
# DEEPGRAM_MODEL=nova-2

# Optional: Override the Deepgram language (default: multi)
# Use 'multi' for automatic multilingual detection.
# DEEPGRAM_LANGUAGE=multi
